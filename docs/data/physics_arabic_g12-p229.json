[{"text":"# الفصل 8\n\n# الفيزياء الذرية\n\n# Atomic Physics\n\n![فوتون منبعث](figure_1)\n\nالأنوار المزيّنة بالألوان والظاهرة في الصورة، قد تمتد آلاف الكيلومترات وتظهر بشكل أقواس أو شرائط أو حزم متذبذبة من اللون، تومض ثم تخبو. سبب هذه الظاهرة الملايين من القفزات الذرّية.\n\n# ما يُتوقّع تحقيقه\n\nتتعلّم في هذا الفصل عن تكمّي الطاقة وأهميتها في وصف إشعاع الجسم الأسود.\n\n# ما أهميته\n\nالتناقض المسمّى بنكبة فوق البنفسجي يكشف الخطأ في تنبّؤ الفيزياء التقليدية حول الطاقة الكلّية اللامتناهية لإشعاعات الجسم الأسود.\n\n# محتوى الفصل 8\n\n1 تكمّي الطاقة\n• إشعاع الجسم الأسود\n• التأثير الكهروضوئي\n2 نماذج الذرّة\n• النماذج الأولى للذرّة\n• الأطياف الذرّية\n• نموذج بور لذرة الهيدروجين","direction":"rtl","runs":[["# الفصل 8\n\n# ",false],["الفيزياء",true],[" ",false],["الذرية\n\n# ",true],["Atomic Physics\n\n",false],["![فوتون",true],[" ",false],["منبعث](figure_1)\n\nالأنوار",true],[" ",false],["المزيّنة",true],[" ",false],["بالألوان والظاهرة",true],[" في الصورة، قد ",false],["تمتد",true],[" ",false],["آلاف",true],[" الكيلومترات ",false],["وتظهر",true],[" ",false],["بشكل",true],[" ",false],["أقواس",true],[" أو شرائط أو ",false],["حزم",true],[" ",false],["متذبذبة",true],[" من اللون، ",false],["تومض",true],[" ثم تخبو. ",false],["سبب",true],[" ",false],["هذه",true],[" ",false],["الظاهرة",true],[" ",false],["الملايين",true],[" من ",false],["القفزات",true],[" ",false],["الذرّية.",true],["\n\n",false],["#",true],[" ما ",false],["يُتوقّع",true],[" ",false],["تحقيقه\n\nتتعلّم",true],[" في هذا ",false],["الفصل",true],[" عن تكمّي ",false],["الطاقة",true],[" ",false],["وأهميتها",true],[" في ",false],["وصف",true],[" ",false],["إشعاع",true],[" الجسم الأسود.\n\n",false],["#",true],[" ما ",false],["أهميته\n\nالتناقض",true],[" المسمّى ",false],["بنكبة",true],[" ",false],["فوق",true],[" ",false],["البنفسجي",true],[" ",false],["يكشف",true],[" الخطأ في ",false],["تنبّؤ",true],[" ",false],["الفيزياء",true],[" ",false],["التقليدية",true],[" ",false],["حول",true],[" ",false],["الطاقة",true],[" "