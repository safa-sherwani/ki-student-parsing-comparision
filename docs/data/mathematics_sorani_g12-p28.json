],["\n\n61 ",false],["بیسەلمێنە",true],[" ",false],["تیرەکانی",true],[" ",false],["مەعین",true],[" ",false],["لەسەر",true],[" ",false],["یه",true],[" ",false],["کتر",true],[" ",false],["ئەستوونن\n\nراست",true],[" ",false],["یان",true],[" ",false],["هەڵە؟",true],[" ",false],["لە پرسیاری",true],[" 62 و 63 دا، ",false],["دیاربکە،",true],[" ",false],["ئەگەر",true],[" ",false],["ڕستەکە",true],[" ",false],["ڕاستە",true],[" ",false],["هۆیەکهی",true],[" ",false],["لێکبدەوە",true],[" ",false],["یان",true],[" ",false],["ئەگەر",true],[" ",false],["هەڵەیە",true],[" به دژه ",false],["نموونەیەک",true],[" ",false],["بیسەلمێنە.",true],["\n\n62 دوو ",false],["ڕاستەهێڵی",true],[" $ax + by = c_1$ و $bx - ay = c_2$ ، ",false],["لەگەڵ",true],[" ",false],["یه",true],[" ",false],["ک",true],[" ",false],["ئەستوونن، کاتێک",true],[" $a \\ne 0$ و $b \\ne 0$.\n\n63 ",false],["دەکرێت",true],[" دوو ",false],["ڕاستەهێل",true],[" ",false],["لارییهکانیان",true],[" ",false],["موجەب",true],[" بێت ",false],["ئەستوون",true],[" بن.",false]]},{"text":"53 كۆمپانيايه‌ك ڕۆژانه 15000 دينار ده‌داته شوفێری بارهه‌ڵگرێك له برى خواردن و پشوودان، و 350 دينار له برى هه‌ر كیلۆمه‌ترێك كه ده‌يبڕێت. نه‌خشه‌يه‌ك بنووسه نموونه‌يه‌ك پێك بهێنێت بۆ هه‌ژماركردنی بڕی ئه‌و پاره‌يه‌ی كۆمپانياكه به شوفێره‌كه‌ی ده‌دات به‌پێی ژماره‌ی ئه‌و كیلۆمه‌ترانه‌ی كه ده‌يبڕێت. شوفێره‌كه 137km بڕی. كۆمپانياكه چه‌ند پاره‌ی پێ ده‌دات؟\n\n54 به‌كاربردنی هێڵی كاتێك ئۆتۆمبێلێك ده‌كڕێت نرخهكه‌ی ساڵ دوای ساڵ داده‌به‌زێت. واته ئۆتۆمبێله‌كه ساڵ له دوای ساڵ بهكارده‌برێت. هه‌ندێك له شاره‌زايانی به‌ڕێوه‌بردن پشت به ڕێسايه‌ك ده‌به‌ستن بۆ هه‌ژماركردنی به‌كاربراوه‌كان. به‌پێی ئه‌م ڕێسايه وا ده‌رده‌كه‌وێت كه نرخی به‌كاربراو له ساڵێكه‌وه بۆ ساڵێكی تر نه‌گۆڕه. يهك له كۆمپانيايه‌كان ئامێرێكی كڕی، نرخهكه‌ی 875000 ديناربوو. ئه‌م ئامێره پاش 5 ساڵ بۆ به‌كارهێنانان ناشێت و هيچ نرخێك ناكات.\nأ نه‌خشه‌يه‌كی هێڵی بنووسه نموونه‌يه‌ك پێكبھێنێت بۆ هه‌ژماركردنی نرخی ئامێره‌كه به پێی كات $t$ ($0 \\le t \\le 5$).\nب نرخی ئه‌م ئامێره چه‌نده كاتێك $t = 2$.\nج پاش چه‌ند كات نرخی