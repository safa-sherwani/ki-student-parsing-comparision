[{"text":"### دەرئەنجامین فیرکاری\n- دەستەفەتیین کوخی د دەستنیشانکرنا هوکاری نەساخییندا، کورت دەکەت.\n- دیار دەکەت کا چەوان پاراستنا لەشی ژ هوکارین نەساخیین دهیتە کرن ب رێیا پیستی و پەردەییین نویسهک.\n- پینگافین بەرسڤدانا هەودانی روون دەکەت.\n- رولی خانەییین سپیین خوینی د بەرهڤانیکرنا هوکارین نەساخییندا دیار دەکەت.\n- رولی تای و پروتینان د بەرهڤانیکرنا هوکارین نەساخییندا دیار دەکەت.\n\n# بەرگریین گشتی\nلەشی مرۆڤی بەردەوام توشی هوکارین نەساخیین دبیت وەکی ڤایروسان و بەکتریا، و دەمی یهک ژ ڤان هوکاران، وەکی ڤایروسی پەرەسیفی، دچیتە دناڤ لەشیدا و زۆر دبیت، و دبیتە ئەگەری وان نەساخیین کو ب نەساخیین ڤەگر Infectious diseases دهینه ناڤکرن. ئەڤ پشکه دیار دەت کا چەوان لەش ئەڤان هوکاران دنیاسیت و بەرگریی ژ خو دکهت دژی وان.\n\n## دەستنیشانکرنا هوکارین نەساخیین\nهوکاری نەساخیین Pathogen هەر تشتەکه کو دبیته ئەگەری نەساخیینی. نوژداری ئەلمانی روبەرت کوخ Robert Koch ($1843-1910$) یهکەمین کهس بوو پیڕابوونەکا کریاری دانای ژ بۆ دەستنیشانکرنا ئەگەری نەساخیینەکا دیارکری، پینگاف، پینگاف. د سالین هەڤتیاندا ژ سەدەی نوژدی کوخ ب ڤەکولین کولکا رەش Anthrax رابوو، کو ئەوژی نەساخیەکه تەرش و کهوالی توش دکهت و دشیت بهیته ڤەکوهستن بۆ مرۆڤان و دناڤدا بەلاف ببیت. کوخی دیت کو خوینیا چێلین توشبووی ب ڤە نەساخیینی، هەژمارەکا مەزن یا بەکتریا تیدایه، ئەوی وهسا هزرکر کو ئەو بەکتریایه دبیته ئەگەری نەساخیا کولکا رەش.\n\nژ بۆ تاقیکرنا مەرتیا خو، کوخی بەکتریا چیلکەیی ژ چێلەکا توشبووی ب نەساخیا کولکا رەش جوداکر، و د چاندنگەهەکیدا ئەو ب بەکتریا چاند دا پشتر است ببیت کو ئەو ژ جۆرەکی بتنییه. پشتر هینگی، ئەوی چێلین ساخ ب وێ بەکتریایی دەرزیکدان و ئەوژی توشبوون ب نەساخیا کولکا رەش. ئەوی دیت کو خوینیا وان چێلان هەر ئەو بەکتریا چیلکەیی تیدایه ئەوا د چیلا ئیَکیدا دیتی. بەلی ئەو چێلین ساخ ئەوین نه دەرزیکداین دڤالانه ژ ڤی بەکتریایی. ئەو گەهشته وی دەرئەنجامی کو ئەو بەکتریا وی جوداکری ئەو بوو بوویه ئەگەری نەساخیا کولکا رەش و ژ ڤان ڤەکولینان، Koch's posetaluts کوخی ئەو ڤە دەینه ناڤکرن ب دەستەفەتیین کوخی، و ئەوین بووینه ئەو بنەمایین کو پشت پی دهیته بەستن ژ بۆ دەستنیشانکرنا هوکاری نەساخیینی.\n\n![شیوەیی 1-3](figure_path)\nشیوەیی 1-3 ئەوان دەستەفەتیان دیار دەکەت.\n\nشیوەیی 1-3\nزانا دشین دەستنیشان کهن نەساخیا فەمگر دەستنیشان بکهن ب رێیا بجهئینانا هەر چوار بنەمایین دەستەفەتیین کوخی.\n\n1. بیدفیه هوکاری نەساخیینی د لەشی گیانهوەری توشبوویدا ب نەساخیینی هەبیت و د گیانهوەرین ساخدا نەبیت.\n2. پیدفیه سامپلەک ژ هوکاری نەساخیینی ژ گیانهوەری توشبووی بهیته جوداکرن و د تاقیگەهیدا گەشه پی بهیته دان.\n3. دەمی گیانهوەرەکی ساخ ب وی هوکاری نەساخیینی نەوێ هاتیه جوداکرن دهیته دەرزیکدان، پیدفیه ئەو گیانهوەر تووشی نەساخیینی ببیت.\n4. بیدفیه هوکاری نەساخیینی ژ گیانهوەری دوویی بدستقه بهیت و د تاقیگەهیدا بەره پی بهیته دان. و بیدفیه هەر ئەو هوکاری نەساخیینی بیت کو ژ گیانهوەری یەکی بدستقه هاتیه و گەشه بیدایه.","direction":"rtl","runs":[["### دەرئەنجامین فیرکاری",true],["\n",false],["- دەستەفەتیین کوخی د دەستنیشانکرنا هوکاری نەساخییندا، کورت دەکەت.\n- دیار دەکەت کا چەوان پاراستنا لەشی ژ هوکارین نەساخیین دهیتە کرن ب رێیا پیستی و پەردەییین نویسهک.\n- پینگافین بەرسڤدانا هەودانی روون دەکەت.\n- رولی خانەییین سپیین خوینی د بەرهڤانیکرنا هوکارین نەساخییندا دیار دەکەت.\n- رولی تای و پروتینان د بەرهڤانیکرنا هوکارین نەساخییندا دیار دەکەت.",true],["\n\n",false],["# بەرگریین",true],[" گشتی",false],["\nلەشی",true],[" مرۆڤی ",false],["بەردەوام",true],[" توشی ",false],["هوکارین",true],[" ",false],["نەساخیین",true],[" دبیت ",false],["وەکی",true],[" ڤایروسان و ",false],["بەکتریا،",true],[" و ",false],["دەمی",true],[" ",false],["یهک",true],[" ژ ڤان ",false],["هوکاران،",true],[" ",false],["وەکی",true],[" ",false],["ڤایروسی",true],[" ",false],["پەرەسیفی،",true],[" ",false],["دچیتە",true],[" دناڤ ",false],["لەشیدا",true],[" و ",false],["زۆر",true],[" دبیت، و ",false],["دبیتە",true],[" ",false],["ئەگەری",true],[" وان ",false],["نەساخیین",true],[" ",false],["کو",true],[" ب ",false],["نەساخیین",true],[" ",false],["ڤەگر",true],[" Infectious diseases ",false],["دهینه",true],[" ",false],["ناڤکرن.",true],[" ",false],["ئەڤ",true],[" ",false],["پشکه",true],[" دیار ",false],["دەت",true],[" ",false],["کا",true],[" ",false],["چەوان",true],[" ",false],[