$N_2 = \\frac{V_2}{V_1} N_1$$\n\n",false],["3. أحسب\n",false],["أعوّض",true],[" ",false],["القيم",true],[" في ",false],["المعادلة",true],[" ",false],["وأحلّ:",true],["\n$$N_2 = \\left( \\frac{2400\\text{ V}}{120\\text{ V}} \\right) (75\\text{ ",false],["لفة})",true],[" = 1500\\text{ ",false],["لفة}$$",true],["\n$$N_2 = 1500\\text{ ",false],["لفة}$$",true],["\n\n",false],["4. ",false],["أقيم",true],["\nيؤدّي ",false],["العدد",true],[" ",false],["الأكبر",true],[" من ",false],["اللفات",true],[" في ",false],["الملف",true],[" ",false],["الثانوي",true],[" إلى ",false],["قيمة",true],[" ",false],["أكبر",true],[" لـ ",false],["$\\varepsilon$",true],[" في ",false],["الدائرة",true],[" ",false],["الثانوية.",true]]},{"text":"عندما تكونُ $N_2$ أكبرَ من $N_1$ ، تكونُ $\\mathcal{E}$ في الملفّ الثانويّ أكبر ممّا هي في الملفّ الابتدائيّ، ويُسمّى المحوّلُ بالمحوّلِ الرافع. لكن إذا كانَتْ $N_2$ أقلَّ من $N_1$ ، فتكونُ $\\mathcal{E}$ في الملفّ الثانويّ أقلَّ ممّا هي في الملفّ الابتدائيّ، ويُسمّى المحوّلُ بالمحوّلِ الخافض.\nقد يتهيّأُ لنا أن المحوّلَ يُنتجُ شيئًا من لا شيءٍ. فمثلًا يستطيعُ المحوّلُ الرافعُ تحويلَ $\\mathcal{E}$ مطبّقةٍ من $10\\text{ V}$ إلى $100\\text{ V}$ ، في وقتٍ يجبُ أن تكونَ فيه القدرةُ في الدائرةِ الثانويّةِ (المخرج) مساويةً (على الأكثر) للقدرةِ في الدائرةِ الابتدائيّةِ (المدخل). لكن في الواقع تضيعُ بعضُ الطاقةِ على شكلِ حرارةٍ أو إشعاعاتٍ، فتكونُ القدرةُ عندَ المخرج أقلّ مما هي عندَ المدخل. يقودُنا ذلك إلى أن أيَّ ازديادٍ في $\\mathcal{E}$ في الدائرةِ الثانويّةِ يعني بالضرورةِ انخفاضًا متناسبًا في التيّارِ الكهربائيّ.\n\n# مثال 6 (ح)\n## المحوّلات\n\n### المسألة\nيُستعملُ محوّلٌ رافعٌ على خطّ فرقِ جُهدٍ $120\\text{ V}$، ليرفعهُ إلى $2400\\text{ V}$. إذا كانَ عددُ اللفاتِ الابتدائيّةِ $75$ فما عددُ اللفاتِ الثانويّةِ؟\n\n### الحلّ\n#### 1. أعرفُ\n**المعطى:** $V_1 = 120\\text{ V} \\quad V_2 = 2400\\text{ V} \\quad N_1 = 75\\text{ لفّة}$\n**المجهول:** $N_2 = ?$\n**الرسم:**\n\n*(رسم تخطيطي لمحول كهربائي يوضح الملف الابتدائي بعدد لفات N₁ = 75 لفة وفرق جهد V₁ = 120 V، والملف الثانوي بعدد لفات مجهول N₂ = ? وفرق جهد V₂ = 2400 V على قلب حديدي مشترك)*\n\n#### 2. أخطّط\nأختارُ معادلةً أو موقفًا: أستعملُ معادلةَ المحوّلِ:\n$$V_2 = \\frac{N_2}{N_1} V_1$$\n\nأُعيدُ ترتيبَ المعادلةِ لأعزلَ المجهولَ:\n$$N_2 = \\frac{V_2}{V_1} N_1$$\n\n#### 3. أحسب\nأُعوّضُ القيمَ في المعادلةِ وأحلُّ:\n$$N_2 = \\left( \\frac{2400\\text{ V}}{120\\text{ V}} \\right) (75\\text{ لفّة}) = 1500\\text{ لفّة}$$\n$$N_2 = 1500\\text{ لفّة}$$\n\n#### 4. أُقيّم\nيؤدّي العددُ الأكبرُ من اللفاتِ في الملفّ الثانويّ إلى قيمةٍ أكبرَ لـ $\\mathcal{E}$ في الدائرةِ الثانويّةِ.\n\n182 الفصل 6","direction":"rtl","runs":[["عندما ",false],["تكونُ",true],[" $N_2$ ",false],["أكبرَ",true],[" من ",false],["$N_1$",true],[" ",false],["،",true],[" ",false],["تكونُ $\\mathcal{E}$",true],[" في ",false],["الملفّ",true],[" ",false],["الثانويّ",true],[" أكبر ",false],["ممّا",true],[" هي في ",false],["الملفّ",true],[" ",false],["الابتدائيّ،",true],[" ويُسمّى ",false],["المحوّلُ",true],[" ",false],["بالمحوّلِ",true],[" الرافع. لكن إذا ",false],["كانَتْ",true],[" $N_2$ ",false],["أقلَّ",true],[" من ",false],["$N_1$",true],[" ",false],["،",true],[" ",false],["فتكونُ $\\mathcal{E}$",true],[" في ",false],["الملفّ",true],[" ",false],["الثانويّ",true],[" ",false],["أقلَّ",true],[" ",false],["ممّا",true],[" هي في ",false],["الملفّ",true],[" ",false],["الابتدائيّ،",true],[" ويُسمّى ",false],["المحوّلُ",true],[" ",false],["بالمحوّلِ",true],[" الخافض.",false],["\n",true],["قد ",false],["يتهيّأُ",true],[" لنا أن ",false],["المحوّلَ",true],[" ",false],["يُنتجُ",true],[" شيئًا من لا ",false],["شيءٍ.",true],[" ",false],["فمثلًا",true],[" ",false],["يستطيعُ",true],[" ",false],["المحوّلُ",true],[" ",false],["الرافعُ",true],[" ",false],["تحويلَ",true],[" ",false],["$\\mathcal{E}$",true],[" ",false],["مطبّقةٍ",true],[" من $10\\text{ V}$ إلى $100\\text{ ",false],["V}$ ،",true],[" في ",false],["وقتٍ",true],[" ",false],["يجبُ",true],[" أن ",false],["تكونَ",true],[" فيه ",false],["القدرةُ",true],[" في ",false],["الدا